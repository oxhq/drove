{
    "name": "oxhq/drove-phase-two-cli",
    "description": "Installed-project proof for the Drove Phase 2 CLI",
    "license": "MIT",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "/drove",
            "options": {
                "reference": "none",
                "symlink": false,
                "versions": {
                    "oxhq/drove": "0.1.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-pcntl": "*",
        "oxhq/drove": "^0.1@dev"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "preferred-install": "dist",
        "sort-packages": true
    }
}
