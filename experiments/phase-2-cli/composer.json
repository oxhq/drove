{
    "name": "oxhq/drove-phase-two-cli",
    "description": "Installed-project proof for the Drove Phase 2 CLI",
    "license": "MIT",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "/drove",
            "options": {
                "reference": "none",
                "symlink": false,
                "versions": {
                    "oxhq/drove": "0.4.0-alpha.1"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-pcntl": "*",
        "oxhq/drove": "^0.4@alpha"
    },
    "autoload": {
        "psr-4": {
            "DroveBetaProof\\": "proof/",
            "DroveBetaProof\\Subject\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "preferred-install": "dist",
        "sort-packages": true
    }
}
