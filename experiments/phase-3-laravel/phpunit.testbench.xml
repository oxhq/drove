<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.0/phpunit.xsd"
    bootstrap="vendor/autoload.php"
    colors="false"
    cacheDirectory=".phpunit.testbench.cache"
>
    <testsuites>
        <testsuite name="Testbench">
            <directory suffix="Test.php">tests/Testbench</directory>
        </testsuite>
    </testsuites>
    <php>
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_DEBUG" value="false" force="true"/>
        <server name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="DB_CONNECTION" value="testbench" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="DROVE_LARAVEL_STATE" value="sqlite-memory" force="true"/>
        <server name="DROVE_LARAVEL_DB_CONNECTION" value="testbench" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
    </php>
</phpunit>
