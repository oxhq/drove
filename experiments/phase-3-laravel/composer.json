{
    "name": "drove/phase-3-laravel-proof",
    "description": "Installed Laravel 13 proof for the Drove Laravel runtime package.",
    "license": "MIT",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "reference": "none",
                "symlink": false,
                "versions": {
                    "oxhq/drove": "0.4.0-alpha.1"
                }
            }
        },
        {
            "type": "path",
            "url": "../../packages/drove-laravel",
            "options": {
                "reference": "none",
                "symlink": false,
                "versions": {
                    "oxhq/drove-laravel": "0.4.0-alpha.1"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-pdo_sqlite": "*",
        "laravel/framework": "^13.0",
        "oxhq/drove": "^0.4@alpha",
        "oxhq/drove-laravel": "^0.4@alpha"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "livewire/livewire": "^4.3.3",
        "orchestra/testbench": "^11.1"
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "proof": "php proof.php",
        "proof:data-provider": "php proof-data-provider.php",
        "proof:guards": "php proof-runtime-guards.php",
        "proof:mysql": "php proof-mysql.php",
        "proof:native": "php proof-native-runtime.php",
        "proof:testbench-guards": "php proof-testbench-guards.php",
        "proof:testbench": "php proof-testbench.php"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "*"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
