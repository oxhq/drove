{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/oxhq/drove/blob/develop/docs/design-partner-evidence.schema.json",
    "title": "Drove design-partner evidence artifact",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "evaluation_id",
        "team",
        "repository",
        "drove",
        "project_revision",
        "evaluation_revision",
        "dependency_state",
        "scanner",
        "benchmark"
    ],
    "properties": {
        "schema": {
            "const": 2
        },
        "evaluation_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "team": {
            "type": "string",
            "minLength": 1
        },
        "repository": {
            "type": "string",
            "pattern": "^https://github\\.com/[^/]+/[^/]+$"
        },
        "drove": {
            "$ref": "#/$defs/drove"
        },
        "project_revision": {
            "$ref": "#/$defs/revision"
        },
        "evaluation_revision": {
            "$ref": "#/$defs/revision"
        },
        "dependency_state": {
            "$ref": "#/$defs/dependency_state"
        },
        "scanner": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "completed",
                "discovered",
                "supported",
                "bridge_only",
                "rejected"
            ],
            "properties": {
                "completed": {
                    "const": true
                },
                "discovered": {
                    "type": "integer",
                    "minimum": 1
                },
                "supported": {
                    "type": "integer",
                    "minimum": 2
                },
                "bridge_only": {
                    "type": "integer",
                    "minimum": 0
                },
                "rejected": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "benchmark": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "completed",
                "selected",
                "case_ids",
                "selection_sha256",
                "platform",
                "runs"
            ],
            "properties": {
                "completed": {
                    "const": true
                },
                "selected": {
                    "type": "integer",
                    "minimum": 2
                },
                "case_ids": {
                    "type": "array",
                    "minItems": 2,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "selection_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "platform": {
                    "$ref": "#/$defs/platform"
                },
                "runs": {
                    "type": "array",
                    "minItems": 3,
                    "contains": {
                        "type": "object",
                        "required": [
                            "runner",
                            "processes",
                            "observed_lanes"
                        ],
                        "properties": {
                            "runner": {
                                "const": "drove"
                            },
                            "processes": {
                                "minimum": 2
                            },
                            "observed_lanes": {
                                "minimum": 2
                            }
                        }
                    },
                    "items": {
                        "$ref": "#/$defs/run"
                    }
                }
            }
        }
    },
    "$defs": {
        "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "drove": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "tag",
                "revision"
            ],
            "properties": {
                "tag": {
                    "type": "string",
                    "pattern": "^v0\\.[0-9]+\\.[0-9]+-alpha\\.[0-9]+$"
                },
                "revision": {
                    "$ref": "#/$defs/revision"
                }
            }
        },
        "dependency_state": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "baseline_lock_sha256",
                "evaluation_lock_sha256",
                "baseline_runner"
            ],
            "properties": {
                "baseline_lock_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "evaluation_lock_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "baseline_runner": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "package",
                        "version",
                        "revision"
                    ],
                    "properties": {
                        "package": {
                            "enum": [
                                "pestphp/pest",
                                "phpunit/phpunit"
                            ]
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1
                        },
                        "revision": {
                            "$ref": "#/$defs/revision"
                        }
                    },
                    "oneOf": [
                        {
                            "properties": {
                                "package": {
                                    "const": "pestphp/pest"
                                },
                                "version": {
                                    "const": "5.0.1"
                                }
                            }
                        },
                        {
                            "properties": {
                                "package": {
                                    "const": "phpunit/phpunit"
                                },
                                "version": {
                                    "const": "13.2.4"
                                }
                            }
                        }
                    ]
                }
            }
        },
        "platform": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "os_family",
                "architecture",
                "native_target",
                "php_version",
                "package_version",
                "package_revision"
            ],
            "properties": {
                "os_family": {
                    "enum": [
                        "Linux",
                        "Darwin"
                    ]
                },
                "architecture": {
                    "enum": [
                        "x86_64",
                        "aarch64",
                        "arm64"
                    ]
                },
                "native_target": {
                    "enum": [
                        "linux-gnu-x86_64",
                        "linux-gnu-aarch64",
                        "macos-x86_64",
                        "macos-aarch64"
                    ]
                },
                "php_version": {
                    "type": "string",
                    "pattern": "^8\\.4\\.[0-9]+$"
                },
                "package_version": {
                    "type": "string",
                    "pattern": "^0\\.[0-9]+\\.[0-9]+-alpha\\.[0-9]+$"
                },
                "package_revision": {
                    "$ref": "#/$defs/revision"
                }
            }
        },
        "run": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "runner",
                "frontend",
                "runtime",
                "command_argv",
                "processes",
                "exit_code",
                "selected",
                "passed",
                "failed",
                "skipped",
                "incomplete",
                "risky",
                "rejected",
                "assertions",
                "wall_ms",
                "peak_memory_bytes",
                "memory_source"
            ],
            "properties": {
                "runner": {
                    "enum": [
                        "pest",
                        "phpunit",
                        "drove"
                    ]
                },
                "frontend": {
                    "enum": [
                        "pest",
                        "phpunit"
                    ]
                },
                "runtime": {
                    "enum": [
                        "php",
                        "laravel",
                        "testbench"
                    ]
                },
                "command_argv": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "processes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                },
                "exit_code": {
                    "const": 0
                },
                "observed_lanes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                },
                "selected": {
                    "type": "integer",
                    "minimum": 1
                },
                "passed": {
                    "type": "integer",
                    "minimum": 0
                },
                "failed": {
                    "type": "integer",
                    "minimum": 0
                },
                "skipped": {
                    "type": "integer",
                    "minimum": 0
                },
                "incomplete": {
                    "type": "integer",
                    "minimum": 0
                },
                "risky": {
                    "type": "integer",
                    "minimum": 0
                },
                "rejected": {
                    "type": "integer",
                    "minimum": 0
                },
                "assertions": {
                    "type": "integer",
                    "minimum": 0
                },
                "wall_ms": {
                    "type": "integer",
                    "minimum": 1
                },
                "peak_memory_bytes": {
                    "type": "integer",
                    "minimum": 1
                },
                "memory_source": {
                    "const": "rss"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "runner": {
                                "const": "drove"
                            }
                        },
                        "required": [
                            "runner"
                        ]
                    },
                    "then": {
                        "required": [
                            "observed_lanes"
                        ]
                    },
                    "else": {
                        "not": {
                            "required": [
                                "observed_lanes"
                            ]
                        }
                    }
                }
            ]
        }
    }
}
