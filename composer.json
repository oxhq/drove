{
    "name": "oxhq/drove",
    "description": "Independent prepared-state test runner with Pest and PHPUnit frontends.",
    "keywords": [
        "php",
        "drove",
        "parallel",
        "prepared-state",
        "laravel",
        "pest",
        "phpunit",
        "unit",
        "test",
        "testing"
    ],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/oxhq/drove",
    "authors": [
        {
            "name": "OxHQ",
            "homepage": "https://github.com/oxhq",
            "role": "Maintainer"
        },
        {
            "name": "Nuno Maduro",
            "email": "enunomaduro@gmail.com",
            "role": "Original Pest author"
        }
    ],
    "support": {
        "issues": "https://github.com/oxhq/drove/issues",
        "source": "https://github.com/oxhq/drove"
    },
    "require": {
        "ext-ffi": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-phar": "*",
        "ext-posix": "*",
        "ext-zlib": "*",
        "php": "^8.4"
    },
    "suggest": {
        "brianium/paratest": "Required only by the explicit Pest compatibility bridge.",
        "nunomaduro/collision": "Required only by the explicit Pest compatibility bridge.",
        "nunomaduro/termwind": "Required only by the explicit Pest compatibility bridge.",
        "pestphp/pest-plugin": "Required only by the explicit Pest compatibility bridge.",
        "phpunit/phpunit": "Required only by the explicit Pest and PHPUnit compatibility bridges.",
        "symfony/process": "Required only by the explicit Pest compatibility bridge."
    },
    "replace": {
        "pestphp/pest": "5.0.1"
    },
    "autoload": {
        "psr-4": {
            "Drove\\": "src/Drove/"
        },
        "files": [
            "src/Drove/Native/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pest\\": "src/",
            "Tests\\Fixtures\\Covers\\": "tests/Fixtures/Covers",
            "Tests\\Fixtures\\Inheritance\\": "tests/Fixtures/Inheritance",
            "Tests\\Fixtures\\Arch\\": "tests/Fixtures/Arch",
            "Tests\\": "tests/PHPUnit/"
        },
        "classmap": [
            "tests/Fixtures/Arch/ToBeCasedCorrectly/IncorrectCasing/incorrectCasing.php"
        ],
        "files": [
            "src/Functions.php",
            "src/Pest.php",
            "tests/Autoload.php"
        ]
    },
    "require-dev": {
        "brianium/paratest": "^7.23.0",
        "laravel/pao": "^1.1.2",
        "nunomaduro/collision": "^8.9.5",
        "nunomaduro/termwind": "^2.4.0",
        "pestphp/pest-dev-tools": "^5.0.0",
        "pestphp/pest-plugin": "^5.0.0",
        "pestphp/pest-plugin-arch": "^5.0.0",
        "pestphp/pest-plugin-browser": "^5.0.0",
        "pestphp/pest-plugin-mutate": "^5.0.0",
        "pestphp/pest-plugin-phpstan": "^5.0.0",
        "pestphp/pest-plugin-profanity": "^5.0.0",
        "pestphp/pest-plugin-rector": "^5.0.0",
        "pestphp/pest-plugin-type-coverage": "^5.0.0",
        "phpunit/phpunit": "13.2.4",
        "psy/psysh": "^0.12.24",
        "symfony/process": "^8.1.0"
    },
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "bin": [
        "bin/drove",
        "bin/drove-evaluate",
        "bin/drove-install-native",
        "bin/pest"
    ],
    "scripts": {
        "lint": [
            "rector",
            "pint --parallel"
        ],
        "test:lint": [
            "rector --dry-run",
            "pint --parallel --test"
        ],
        "test:profanity": "php bin/pest --profanity --compact",
        "test:type:check": "phpstan analyse --ansi --memory-limit=-1 --debug",
        "test:type:coverage": "php -d memory_limit=-1  bin/pest --type-coverage --min=100",
        "test:unit": "php bin/pest --exclude-group=integration --compact",
        "test:inline": "php bin/pest --configuration=phpunit.inline.xml",
        "test:native-phase-1": "php experiments/native-phase-1/proof.php",
        "test:native-phase-1:static": [
            "phpstan analyse src/Drove/Native src/Drove/Kernel/AssertionFailed.php src/Drove/Kernel/FailureKind.php experiments/native-phase-1/proof.php --no-progress --memory-limit=512M",
            "pint --test src/Drove/Native src/Drove/Kernel/AssertionFailed.php src/Drove/Kernel/FailureKind.php experiments/native-phase-1"
        ],
        "test:native-phase-2": "php experiments/native-phase-2/proof.php",
        "test:native-phase-2:static": [
            "phpstan analyse src/Drove/Extension src/Drove/Native src/Drove/Replay/Artifact.php experiments/native-phase-2/proof.php experiments/native-phase-2/fixtures.php experiments/native-phase-2/compare.php --no-progress --memory-limit=512M",
            "pint --test src/Drove/Extension src/Drove/Native src/Drove/Replay/Artifact.php experiments/native-phase-2"
        ],
        "test:native-phase-3": "php experiments/native-phase-3/proof.php",
        "test:native-phase-3:static": [
            "phpstan analyse src/Drove/Native experiments/native-phase-3/proof.php experiments/native-phase-3/compare.php --no-progress --memory-limit=512M",
            "pint --test src/Drove/Native experiments/native-phase-3"
        ],
        "test:native-phase-4-core": "php experiments/native-phase-4-core/proof.php",
        "test:native-phase-4-core:static": [
            "phpstan analyse src/Drove/Native experiments/native-phase-4-core/proof.php --no-progress --memory-limit=512M",
            "pint --test src/Drove/Native experiments/native-phase-4-core"
        ],
        "test:native-phase-5": "bash experiments/native-phase-5/gate.sh",
        "test:native-phase-5:static": [
            "phpstan analyse experiments/native-phase-5 --no-progress --memory-limit=512M",
            "pint --test experiments/native-phase-5"
        ],
        "test:native-phase-6-bridges": "php experiments/native-phase-6-bridges/proof.php",
        "test:native-phase-6-bridges:static": [
            "phpstan analyse src/Drove/Compatibility src/Drove/CompatibilityRegistry.php src/Drove/Bridge src/Drove/Migration src/Drove/Native/Surface/DependencyGuard.php experiments/native-phase-6-bridges --no-progress --memory-limit=512M",
            "pint --test src/Drove/Compatibility src/Drove/CompatibilityRegistry.php src/Drove/Bridge src/Drove/Migration src/Drove/Native/Surface/DependencyGuard.php experiments/native-phase-6-bridges packages/drove-laravel/src/TestbenchBridge.php"
        ],
        "test:native-corpus-1": "bash experiments/native-corpus-1/run.sh",
        "test:native-corpus-1:environment": "bash experiments/native-corpus-1/run.sh --lock-only",
        "test:native-corpus-1:static": [
            "@test:native-corpus-1:environment",
            "phpstan analyse experiments/native-corpus-1/proof.php experiments/native-corpus-1/PestCorpusCodemod.php experiments/native-corpus-1/fixtures.php experiments/native-corpus-1/exclusions.php experiments/native-corpus-1/generate-baseline.php experiments/native-corpus-1/dataset-diagnostic-command.php experiments/native-corpus-1/dataset-diagnostics benchmarks/corpus/PestDatasetIdentity.php benchmarks/corpus/verify-native-pest-environment.php --no-progress --memory-limit=512M",
            "pint --test experiments/native-corpus-1 benchmarks/corpus/PestDatasetIdentity.php benchmarks/corpus/verify-native-pest-environment.php"
        ],
        "test:native-corpus-inventory": "php benchmarks/corpus/verify-native-surface-inventory.php",
        "test:native-corpus-inventory:static": [
            "phpstan analyse benchmarks/corpus/PestDatasetIdentity.php benchmarks/corpus/generate-native-surface-inventory.php benchmarks/corpus/verify-native-surface-inventory.php experiments/native-corpus-1/PestCorpusCodemod.php experiments/native-corpus-1/codemod-options.php experiments/native-invoiceshelf-corpus/codemod-options.php experiments/native-filament-corpus/profile.php experiments/native-filament-corpus/case-parity.php experiments/native-filament-corpus/generate-baseline.php experiments/native-filament-corpus/verify-baseline.php experiments/native-filament-corpus/gate.php --no-progress --memory-limit=512M",
            "pint --test benchmarks/corpus/PestDatasetIdentity.php benchmarks/corpus/generate-native-surface-inventory.php benchmarks/corpus/verify-native-surface-inventory.php experiments/native-corpus-1/codemod-options.php experiments/native-invoiceshelf-corpus/codemod-options.php experiments/native-filament-corpus/profile.php experiments/native-filament-corpus/case-parity.php experiments/native-filament-corpus/generate-baseline.php experiments/native-filament-corpus/verify-baseline.php experiments/native-filament-corpus/gate.php experiments/native-filament-corpus/proof.php"
        ],
        "test:native-benchmark": "php benchmarks/corpus/native-benchmark-self-test.php",
        "test:native-benchmark:static": [
            "phpstan analyse benchmarks/corpus/PestDatasetIdentity.php benchmarks/corpus/native-benchmark.php benchmarks/corpus/native-benchmark-corpora.php benchmarks/corpus/native-benchmark-evidence.php benchmarks/corpus/native-benchmark-measure.php benchmarks/corpus/native-benchmark-prepare.php benchmarks/corpus/native-benchmark-runner.php benchmarks/corpus/native-benchmark-self-test.php experiments/native-invoiceshelf-corpus/gate.php experiments/native-filament-corpus/case-parity.php experiments/native-filament-corpus/gate.php experiments/phase-3-laravel/native-package/gate.php --no-progress --memory-limit=512M",
            "pint --test benchmarks/corpus/native-benchmark.php benchmarks/corpus/native-benchmark-corpora.php benchmarks/corpus/native-benchmark-evidence.php benchmarks/corpus/native-benchmark-measure.php benchmarks/corpus/native-benchmark-prepare.php benchmarks/corpus/native-benchmark-runner.php benchmarks/corpus/native-benchmark-self-test.php experiments/native-invoiceshelf-corpus/gate.php experiments/native-filament-corpus/gate.php experiments/phase-3-laravel/native-package/gate.php"
        ],
        "test:native-expectation-catalog": "php experiments/native-expectation-catalog/proof.php",
        "test:native-expectation-catalog:static": [
            "phpstan analyse src/Drove/Native/Expectation.php src/Drove/Migration/Scanner.php src/Drove/Migration/Migrator.php src/Drove/Native/Surface/SupportedSurface.php experiments/native-expectation-catalog/proof.php --no-progress --memory-limit=512M",
            "pint --test src/Drove/Native/Expectation.php src/Drove/Migration/Scanner.php src/Drove/Migration/Migrator.php src/Drove/Native/Surface/SupportedSurface.php experiments/native-expectation-catalog"
        ],
        "test:native-class-frontend": "php experiments/native-class-frontend/proof.php",
        "test:native-class-migration": "php experiments/native-class-migration/proof.php",
        "test:native-class-migration:static": [
            "phpstan analyse src/Drove/Native/Attributes src/Drove/Native/ClassFrontend.php src/Drove/Migration/AssertionCallMigrator.php src/Drove/Migration/ClassMigrator.php experiments/native-class-frontend experiments/native-class-migration --no-progress --memory-limit=512M",
            "pint --test src/Drove/Native/Attributes src/Drove/Native/ClassFrontend.php src/Drove/Migration/AssertionCallMigrator.php src/Drove/Migration/ClassMigrator.php experiments/native-class-frontend experiments/native-class-migration"
        ],
        "test:native-laravel-migration": "php experiments/native-laravel-migration/proof.php",
        "test:native-laravel-migration:static": [
            "phpstan analyse src/Drove/Migration/AssertionCallMigrator.php src/Drove/Migration/LaravelMigrator.php src/Drove/Migration/LaravelMigrationResult.php experiments/native-laravel-migration --no-progress --memory-limit=512M",
            "pint --test src/Drove/Migration/AssertionCallMigrator.php src/Drove/Migration/LaravelMigrator.php src/Drove/Migration/LaravelMigrationResult.php experiments/native-laravel-migration"
        ],
        "test:native-livewire-package": [
            "Composer\\Config::disableProcessTimeout",
            "php experiments/phase-3-laravel/native-package/gate.php"
        ],
        "test:package-boundary": "php scripts/verify-package-boundary.php",
        "test:parallel": "php bin/pest --exclude-group=integration --parallel --processes=3",
        "test:integration": "php bin/pest --group=integration -v",
        "update:snapshots": "REBUILD_SNAPSHOTS=true php bin/pest --update-snapshots",
        "test": [
            "@test:lint",
            "@test:type:check",
            "@test:type:coverage",
            "@test:unit",
            "@test:parallel",
            "@test:integration"
        ]
    },
    "extra": {
        "drove": {
            "native-entrypoint": "bin/drove",
            "bridge-only": {
                "autoload-files": [
                    "src/Functions.php",
                    "src/Pest.php"
                ],
                "binaries": [
                    "bin/drove --pest",
                    "bin/pest"
                ],
                "composer-plugins": [
                    "pestphp/pest-plugin"
                ],
                "namespaces": [
                    "Pest\\"
                ],
                "replaces": [
                    "pestphp/pest"
                ]
            }
        },
        "pest": {
            "plugins": [
                "Pest\\Plugins\\Configuration",
                "Pest\\Plugins\\Bail",
                "Pest\\Plugins\\Cache",
                "Pest\\Plugins\\Coverage",
                "Pest\\Plugins\\Init",
                "Pest\\Plugins\\Environment",
                "Pest\\Plugins\\Help",
                "Pest\\Plugins\\Memory",
                "Pest\\Plugins\\Only",
                "Pest\\Plugins\\Printer",
                "Pest\\Plugins\\ProcessIsolation",
                "Pest\\Plugins\\Profile",
                "Pest\\Plugins\\Retry",
                "Pest\\Plugins\\Snapshot",
                "Pest\\Plugins\\Verbose",
                "Pest\\Plugins\\Version",
                "Pest\\Plugins\\Shard",
                "Pest\\Plugins\\Tia",
                "Pest\\Plugins\\Parallel"
            ]
        },
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    }
}
