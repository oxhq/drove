{
    "name": "oxhq/drove-laravel",
    "description": "Narrow Laravel runtime integration for Drove.",
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/oxhq/drove-laravel",
    "authors": [
        {
            "name": "OxHQ",
            "homepage": "https://github.com/oxhq",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/oxhq/drove/issues",
        "source": "https://github.com/oxhq/drove-laravel"
    },
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "oxhq/drove": "^0.4@alpha"
    },
    "suggest": {
        "orchestra/testbench": "Required only for package suites; tested with ^11.1."
    },
    "autoload": {
        "files": [
            "src/functions.php"
        ],
        "psr-4": {
            "Drove\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Drove\\Laravel\\DroveLaravelServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
